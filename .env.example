# Agent Space environment variables (docs/ARCHITECTURE.md section 7).
# Every variable is optional. Node does not load this file by itself:
#   node --env-file=.env packages/server/src/main.js
# Never commit a real token or credential into this file.

# --- Server ---------------------------------------------------------------
# HTTP port and bind address. Use HOST=0.0.0.0 only together with
# AGENT_SPACE_TOKEN (shared/remote mode); localhost needs no token.
PORT=5173
HOST=127.0.0.1

# Load the simulated demo workspace at startup (false = manual only).
DEMO=true

# SQLite database file, or ":memory:" for a throwaway database.
AGENT_SPACE_DB=data/agent-space.sqlite

# Bearer token required on every /api request and WebSocket in shared mode.
#AGENT_SPACE_TOKEN=

# Server URL used by the CLI (bin/agent-space.js) and the Claude Code hook.
AGENT_SPACE_URL=http://127.0.0.1:5173

# --- Observation (sessions started outside Agent Space) -------------------
# "false" keeps the observers registered but never starts polling.
AGENT_SPACE_OBSERVE=true
# Milliseconds between observer polls.
AGENT_SPACE_OBSERVE_INTERVAL=2000

# --- Managed runs ---------------------------------------------------------
# Worktrees (data/worktrees/<runId>) and artifacts live here.
AGENT_SPACE_DATA_DIR=data

# Binary overrides: provider id upper-cased with "-" -> "_". The value is a
# command line (quotes honoured) and may include arguments, e.g. the fake
# CLIs used by the tests. Leave unset to resolve the CLI from PATH.
#AGENT_SPACE_BIN_CLAUDE_CODE="C:\Users\me\.local\bin\claude.exe"
#AGENT_SPACE_BIN_CLAUDE_CODE=node "tests/fixtures/fake-cli/claude.js"
#AGENT_SPACE_BIN_CODEX=
#AGENT_SPACE_BIN_COPILOT=
#AGENT_SPACE_BIN_CURSOR=
#AGENT_SPACE_BIN_GEMINI=

# --- Provider home directories (read-only; defaults shown) ----------------
# Point these at other folders to observe/test a different install. They are
# also honoured by the provider CLIs themselves.
#CLAUDE_CONFIG_DIR=~/.claude
#CODEX_HOME=~/.codex
#COPILOT_HOME=~/.copilot
#CURSOR_HOME=~/.cursor
#GEMINI_HOME=~/.gemini

# --- Operations (wave 2) --------------------------------------------------
# Milliseconds between drains of the outbound webhook queue (main.js).
AGENT_SPACE_WEBHOOK_INTERVAL=30000
# Milliseconds between health-level refreshes. The full snapshot is always
# computed on demand by GET /api/ops/health; this timer only re-broadcasts the
# global channel when the level changes.
AGENT_SPACE_HEALTH_INTERVAL=60000

# Webhook signing secrets are NEVER stored in the database. An endpoint stores
# only the NAME of an environment variable (its `secretRef`), and the value is
# read from the process environment at delivery time. An outbound delivery is
# refused rather than sent unsigned when the variable is missing. Name them
# however you like; one variable per endpoint:
#AGENT_SPACE_WEBHOOK_SECRET_CI=

# --- MCP bridge -----------------------------------------------------------
# bin/agent-space-mcp.js exposes Agent Space tools to an MCP client over stdio.
# It talks to the same HTTP API, so it needs AGENT_SPACE_URL (above) and, in
# shared mode, AGENT_SPACE_TOKEN. This build ships the bridge only when the MCP
# module is present; see OPTIONAL_MODULES in packages/core/src/services.js.
#AGENT_SPACE_MCP_STDIO=true

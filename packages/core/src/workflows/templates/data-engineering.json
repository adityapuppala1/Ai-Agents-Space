{
  "id": "data-engineering",
  "name": "Data engineering",
  "domain": "Data",
  "priority": "Growth",
  "description": "Ingest -> transform -> validate -> publish artifact. Produces a dataset version, a lineage record, and a validation report from executed commands.",
  "requiredResult": "Dataset version, lineage, validation report",
  "roles": [
    {
      "key": "ingest",
      "name": "Ingest engineer",
      "workingState": "CODING",
      "provider": null,
      "skills": ["extraction", "file formats"]
    },
    {
      "key": "transform",
      "name": "Transform engineer",
      "workingState": "CODING",
      "provider": null,
      "skills": ["etl", "schema mapping"]
    },
    {
      "key": "validator",
      "name": "Validator",
      "workingState": "TESTING",
      "provider": null,
      "skills": ["data quality", "assertions"]
    },
    {
      "key": "publisher",
      "name": "Publisher",
      "workingState": "REVIEWING",
      "provider": null,
      "skills": ["lineage", "versioning"]
    }
  ],
  "steps": [
    {
      "key": "ingest",
      "title": "Ingest {{dataset}} from {{source}}",
      "role": "ingest",
      "instructions": "Write an ingest script that copies {{source}} into data/raw/{{dataset}}/ and run it. Record the command, its exit code, the row count, and the byte size.",
      "deliverable": "data/raw/<dataset>/ populated by an executed command",
      "acceptance": [
        "file-edited:data",
        "command-exit-zero:/ingest|extract|copy|download|curl|node|python/"
      ],
      "contract": {
        "inputs": [
          {
            "key": "dataset",
            "type": "string",
            "required": true
          },
          {
            "key": "source",
            "type": "string",
            "required": true
          }
        ],
        "outputSchema": null,
        "completionCriteria": [
          "file-edited:data",
          "command-exit-zero:/ingest|extract|copy|download|curl|node|python/"
        ],
        "timeoutMs": 900000,
        "allowedTools": ["file.read", "file.edit", "shell"],
        "budget": {
          "maxTokens": null,
          "maxRuns": 2
        },
        "reviewer": null
      },
      "dependsOn": [],
      "branchCondition": null
    },
    {
      "key": "transform",
      "title": "Transform {{dataset}}",
      "role": "transform",
      "instructions": "Write and run the transform that produces data/curated/{{dataset}}/. Record the command, its exit code, and the input and output row counts.",
      "deliverable": "data/curated/<dataset>/ produced by an executed command",
      "acceptance": [
        "file-edited:data",
        "command-exit-zero:/transform|etl|node|python|dbt/"
      ],
      "contract": {
        "inputs": [],
        "outputSchema": null,
        "completionCriteria": [
          "file-edited:data",
          "command-exit-zero:/transform|etl|node|python|dbt/"
        ],
        "timeoutMs": 900000,
        "allowedTools": ["file.read", "file.edit", "shell"],
        "budget": {
          "maxTokens": null,
          "maxRuns": 2
        },
        "reviewer": null
      },
      "dependsOn": ["ingest"],
      "branchCondition": null
    },
    {
      "key": "validate",
      "title": "Validate {{dataset}}",
      "role": "validator",
      "instructions": "Run the data quality checks (row counts, null rates, key uniqueness, referential checks) and write data/validation/{{dataset}}.md plus a JSON report matching the output schema. A check that did not run is reported as not-run, never as passed.",
      "deliverable": "Validation report with executed checks",
      "acceptance": [
        "command-exit-zero:/validate|check|assert|test/",
        "file-edited:data",
        "output-schema"
      ],
      "contract": {
        "inputs": [],
        "outputSchema": {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "string"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["passed", "failed", "not-run"]
                  },
                  "command": {
                    "type": "string"
                  },
                  "exitCode": {
                    "type": "integer"
                  }
                },
                "required": ["name", "status"]
              }
            },
            "rowCount": {
              "type": "integer"
            }
          },
          "required": ["dataset", "checks"]
        },
        "completionCriteria": [
          "command-exit-zero:/validate|check|assert|test/",
          "file-edited:data",
          "output-schema"
        ],
        "timeoutMs": 900000,
        "allowedTools": ["file.read", "file.edit", "shell", "shell.test"],
        "budget": {
          "maxTokens": null,
          "maxRuns": 2
        },
        "reviewer": null
      },
      "dependsOn": ["transform"],
      "branchCondition": null
    },
    {
      "key": "publish",
      "title": "Publish {{dataset}} with lineage",
      "role": "publisher",
      "instructions": "Write data/lineage/{{dataset}}.json: the dataset version, the source, every command that produced it with its exit code, the validation report path, and the output paths. Finish with JSON matching the output schema.",
      "deliverable": "data/lineage/<dataset>.json",
      "acceptance": ["file-edited:data", "output-schema"],
      "contract": {
        "inputs": [],
        "outputSchema": {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "outputPath": {
              "type": "string"
            },
            "validationReport": {
              "type": "string"
            },
            "lineage": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string"
                  },
                  "exitCode": {
                    "type": "integer"
                  }
                },
                "required": ["step", "command"]
              }
            }
          },
          "required": [
            "dataset",
            "version",
            "outputPath",
            "validationReport",
            "lineage"
          ]
        },
        "completionCriteria": ["file-edited:data", "output-schema"],
        "timeoutMs": 900000,
        "allowedTools": ["file.read", "file.edit"],
        "budget": {
          "maxTokens": null,
          "maxRuns": 2
        },
        "reviewer": "human"
      },
      "dependsOn": ["validate"],
      "branchCondition": null
    }
  ],
  "outputSchema": {
    "type": "object",
    "properties": {
      "dataset": {
        "type": "string"
      },
      "version": {
        "type": "string"
      },
      "outputPath": {
        "type": "string"
      },
      "validationReport": {
        "type": "string"
      },
      "lineage": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "step": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "exitCode": {
              "type": "integer"
            }
          },
          "required": ["step", "command"]
        }
      },
      "rowCount": {
        "type": "integer"
      }
    },
    "required": [
      "dataset",
      "version",
      "outputPath",
      "validationReport",
      "lineage"
    ]
  },
  "rubric": [
    {
      "criterion": "Each stage ran a command that exited 0",
      "howMeasured": "Recorded command events for ingest, transform, and validate each report exit code 0",
      "failsWhen": "A stage is reported complete with no recorded command"
    },
    {
      "criterion": "Validation results are per check",
      "howMeasured": "The checks array names each check with passed / failed / not-run and its exit code",
      "failsWhen": "A check that never ran is reported as passed"
    },
    {
      "criterion": "Lineage links every output to the command that produced it",
      "howMeasured": "lineage entries pair a step with the recorded command and exit code",
      "failsWhen": "An output path appears with no producing command"
    },
    {
      "criterion": "The dataset version is explicit",
      "howMeasured": "version is set in data/lineage/<dataset>.json",
      "failsWhen": "The published dataset has no version string"
    }
  ],
  "requiredTools": ["file.read", "file.edit", "shell", "shell.test"],
  "requiredConnectors": ["local-filesystem", "object-storage"],
  "sampleInputs": {
    "dataset": "orders",
    "source": "data/raw/orders.csv"
  },
  "notes": "requiredConnectors lists object-storage, which is NOT implemented in this build. Everything runs against the local filesystem inside the run scope; lineage is a file this pack writes, not a catalogue service."
}

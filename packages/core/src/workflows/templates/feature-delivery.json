{
  "id": "feature-delivery",
  "name": "Feature delivery",
  "domain": "Software engineering",
  "priority": "Launch",
  "description": "Brief -> architect -> frontend/backend -> QA -> reviewer. Produces a reviewed patch, recorded test results, and implementation notes.",
  "requiredResult": "Reviewed patch, test results, implementation notes",
  "roles": [
    {
      "key": "architect",
      "name": "Architect",
      "workingState": "ANALYZING",
      "provider": null,
      "skills": ["planning", "interface design", "risk analysis"]
    },
    {
      "key": "frontend",
      "name": "Frontend developer",
      "workingState": "CODING",
      "provider": null,
      "skills": ["ui", "accessibility", "state management"]
    },
    {
      "key": "backend",
      "name": "Backend developer",
      "workingState": "CODING",
      "provider": null,
      "skills": ["api design", "data modelling", "migrations"]
    },
    {
      "key": "qa",
      "name": "QA engineer",
      "workingState": "TESTING",
      "provider": null,
      "skills": ["test design", "regression testing"]
    },
    {
      "key": "reviewer",
      "name": "Reviewer",
      "workingState": "REVIEWING",
      "provider": null,
      "skills": ["code review", "risk review"]
    }
  ],
  "steps": [
    {
      "key": "plan",
      "title": "Plan {{feature}}",
      "role": "architect",
      "instructions": "Read the brief for {{feature}}. Write a plan to plans/{{feature}}.md listing the files to change, the interfaces, the data changes, and the risks. Do not write product code in this step.",
      "deliverable": "Implementation plan (files, interfaces, risks)",
      "acceptance": ["file-edited:plans", "final-message-non-empty"],
      "contract": {
        "inputs": [
          {
            "key": "feature",
            "type": "string",
            "required": true
          }
        ],
        "outputSchema": null,
        "completionCriteria": ["file-edited:plans", "final-message-non-empty"],
        "timeoutMs": 900000,
        "allowedTools": ["file.read", "search", "file.edit"],
        "budget": {
          "maxTokens": null,
          "maxRuns": 2
        },
        "reviewer": null
      },
      "dependsOn": [],
      "branchCondition": null
    },
    {
      "key": "frontend",
      "title": "Implement UI for {{feature}}",
      "role": "frontend",
      "instructions": "Implement the UI part of plans/{{feature}}.md. Keep the diff limited to the files named in the plan. Run the project build or lint command before finishing.",
      "deliverable": "Frontend patch (git diff)",
      "acceptance": ["file-edited", "artifact:diff"],
      "contract": {
        "inputs": [
          {
            "key": "feature",
            "type": "string",
            "required": true
          }
        ],
        "outputSchema": null,
        "completionCriteria": ["file-edited", "artifact:diff"],
        "timeoutMs": 900000,
        "allowedTools": ["file.read", "file.edit", "shell.build", "git.diff"],
        "budget": {
          "maxTokens": null,
          "maxRuns": 2
        },
        "reviewer": null
      },
      "dependsOn": ["plan"],
      "branchCondition": null
    },
    {
      "key": "backend",
      "title": "Implement backend for {{feature}}",
      "role": "backend",
      "instructions": "Implement the API and data part of plans/{{feature}}.md. Keep schema changes additive. Run the project build command before finishing.",
      "deliverable": "Backend patch (git diff)",
      "acceptance": ["file-edited", "artifact:diff"],
      "contract": {
        "inputs": [
          {
            "key": "feature",
            "type": "string",
            "required": true
          }
        ],
        "outputSchema": null,
        "completionCriteria": ["file-edited", "artifact:diff"],
        "timeoutMs": 900000,
        "allowedTools": ["file.read", "file.edit", "shell.build", "git.diff"],
        "budget": {
          "maxTokens": null,
          "maxRuns": 2
        },
        "reviewer": null
      },
      "dependsOn": ["plan"],
      "branchCondition": null
    },
    {
      "key": "qa",
      "title": "Test {{feature}}",
      "role": "qa",
      "instructions": "Write or extend tests for {{feature}} and run the project test command. Report the exact command and its exit code. Never edit product code to make a test pass without saying so.",
      "deliverable": "Recorded test command output",
      "acceptance": ["test-passed", "artifact:test-output"],
      "contract": {
        "inputs": [
          {
            "key": "feature",
            "type": "string",
            "required": true
          }
        ],
        "outputSchema": null,
        "completionCriteria": ["test-passed", "artifact:test-output"],
        "timeoutMs": 900000,
        "allowedTools": ["file.read", "file.edit", "shell.test"],
        "budget": {
          "maxTokens": null,
          "maxRuns": 2
        },
        "reviewer": null
      },
      "dependsOn": ["frontend", "backend"],
      "branchCondition": null
    },
    {
      "key": "review",
      "title": "Review {{feature}} patch",
      "role": "reviewer",
      "instructions": "Review the combined diff and the recorded test output for {{feature}}. List defects with file and line. Finish with a JSON object matching the output schema.",
      "deliverable": "Review report (JSON) and accept/reject decision",
      "acceptance": [
        "artifact:diff",
        "final-message-non-empty",
        "output-schema"
      ],
      "contract": {
        "inputs": [],
        "outputSchema": {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "enum": ["accept", "reject"],
              "description": "Recorded decision, not a quality score"
            },
            "changedFiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "testCommand": {
              "type": "string"
            },
            "testExitCode": {
              "type": "integer"
            },
            "defects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": ["file", "detail"]
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "decision",
            "changedFiles",
            "testCommand",
            "testExitCode"
          ]
        },
        "completionCriteria": [
          "artifact:diff",
          "final-message-non-empty",
          "output-schema"
        ],
        "timeoutMs": 600000,
        "allowedTools": ["file.read", "git.diff", "search"],
        "budget": {
          "maxTokens": null,
          "maxRuns": 2
        },
        "reviewer": "human"
      },
      "dependsOn": ["qa"],
      "branchCondition": null
    }
  ],
  "outputSchema": {
    "type": "object",
    "properties": {
      "patch": {
        "type": "string",
        "description": "Unified diff captured as the run's diff artifact"
      },
      "testCommand": {
        "type": "string"
      },
      "testExitCode": {
        "type": "integer"
      },
      "testOutput": {
        "type": "string"
      },
      "planFile": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      },
      "decision": {
        "type": "string",
        "enum": ["accept", "reject"]
      }
    },
    "required": ["patch", "testCommand", "testExitCode", "decision"]
  },
  "rubric": [
    {
      "criterion": "A plan file exists before code is written",
      "howMeasured": "A file edit event under plans/ is recorded on the plan step",
      "failsWhen": "The plan step recorded no file edit under plans/"
    },
    {
      "criterion": "Every code step produced a diff",
      "howMeasured": "The run captured a diff artifact (git diff in the run cwd or worktree)",
      "failsWhen": "A code step finished with no diff artifact"
    },
    {
      "criterion": "Tests were executed, not described",
      "howMeasured": "A recorded test command reported exit code 0 and a test-output artifact exists",
      "failsWhen": "The final message claims tests pass but no command event with exit code 0 was recorded"
    },
    {
      "criterion": "The review decision is recorded",
      "howMeasured": "The review step emitted JSON matching the output schema with a decision field",
      "failsWhen": "The review step produced no parsable JSON result"
    },
    {
      "criterion": "No secrets and no unrelated files in the patch",
      "howMeasured": "The diff artifact skips secret paths (isSecretPath) and the reviewer lists changedFiles",
      "failsWhen": "The diff touches files outside the plan and the review does not name them"
    }
  ],
  "requiredTools": [
    "file.read",
    "file.edit",
    "search",
    "shell.build",
    "shell.test",
    "git.diff"
  ],
  "requiredConnectors": ["local-filesystem", "git"],
  "sampleInputs": {
    "feature": "Saved filters on the board view"
  },
  "notes": "Fan-out (frontend/backend) then fan-in at QA. The required result is produced by whichever provider runs the tasks; Agent Space records the evidence, it never judges quality."
}
